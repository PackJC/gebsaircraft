# tools and everything they work from (models, bakes, textures, renders) live
# outside the mod in Documents\gebsaircraft-dev. Should they be moved back in
# to rebuild something, they stay out of the repo. Anchored to the top folder.
/tools/
/source/
/server/
/Workbench/

